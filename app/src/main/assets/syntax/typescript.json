{
  "name": ["TypeScript", ".ts", ".tsx", ".mts", ".cts"],
  "comment": [
    { "startsWith": "//" },
    { "startsWith": "/*", "endsWith": "*/" }
  ],
  "rules": [
    { "type": "comment", "regex": "//.*" },
    { "type": "comment", "regex": "/\\*[\\s\\S]*?\\*/" },
    { "type": "string", "regex": "`(?:\\\\.|[^`])*`" },
    { "type": "string", "regex": "\"(?:\\\\.|[^\"])*\"" },
    { "type": "string", "regex": "'(?:\\\\.|[^'])*'" },
    { "type": "string", "regex": "/(?:\\\\.|[^/])+/[gimsuy]*" },
    { "type": "number", "regex": "\\b(?:0[xXoObB][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b" },
    { "type": "keyword", "keywords": ["abstract", "any", "as", "asserts", "async", "await", "boolean", "break", "case", "catch", "class", "const", "constructor", "continue", "debugger", "declare", "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for", "from", "function", "get", "if", "implements", "import", "in", "infer", "instanceof", "interface", "is", "keyof", "let", "module", "namespace", "never", "new", "null", "number", "object", "of", "package", "private", "protected", "public", "readonly", "return", "satisfies", "set", "static", "string", "super", "switch", "symbol", "target", "this", "throw", "true", "try", "type", "typeof", "undefined", "unique", "unknown", "var", "void", "while", "with", "yield"] },
    { "type": "operator", "regex": "[+\\-*/%=&|!<>^~?:]+|===|!==|=>|\\.\\.\\.|\\.|,|;|\\(|\\)|\\{|\\}|\\[|\\]" },
    { "type": "default", "regex": "." }
  ]
}