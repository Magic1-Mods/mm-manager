{
  "name": ["Groovy", ".groovy", ".gvy", ".gy", ".gsh"],
  "comment": [
    { "startsWith": "//" },
    { "startsWith": "/*", "endsWith": "*/" }
  ],
  "rules": [
    { "type": "comment", "regex": "//.*" },
    { "type": "comment", "regex": "/\\*[\\s\\S]*?\\*/" },
    { "type": "string", "regex": "\"\"\"[\\s\\S]*?\"\"\"" },
    { "type": "string", "regex": "'(?:\\\\.|[^'])*'" },
    { "type": "string", "regex": "/\"(?:\\\\.|[^\"])*\"/" },
    { "type": "string", "regex": "/(?:\\\\.|[^/])+/" },
    { "type": "number", "regex": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[fFdDgGiI]?\\b" },
    { "type": "keyword", "keywords": ["abstract", "as", "assert", "break", "case", "catch", "class", "const", "continue", "def", "default", "do", "else", "enum", "extends", "false", "finally", "for", "goto", "if", "implements", "import", "in", "instanceof", "interface", "mixin", "native", "new", "null", "package", "private", "protected", "public", "return", "static", "strictfp", "super", "switch", "synchronized", "this", "throw", "throws", "trait", "transient", "true", "try", "var", "void", "volatile", "while"] },
    { "type": "keyword2", "keywords": ["as", "def", "in", "it", "use", "with", "each", "any", "every", "find", "findAll", "collect", "inject", "sort", "reverse", "flatten", "grep", "groupBy", "countBy", "sum", "min", "max", "average", "join", "split", "tokenize", "replaceAll", "replaceFirst", "padLeft", "padRight", "center", "startsWith", "endsWith", "contains", "matches", "toList", "toSet", "toMap", "asList", "asSet", "asMap", "asImmutable", "asSynchronized", "asUnmodifiable"] },
    { "type": "constant", "regex": "\\b[A-Z][A-Z0-9_]+\\b" },
    { "type": "operator", "regex": "[+\\-*/%=&|!<>^~?:]+|==|!=|<=|>=|&&|\\|\\||<<|>>|==~|!=~|\\.\\.|\\.\\.<|\\?\\.|\\.&|\\.@|\\.|,|;|\\(|\\)|\\{|\\}|\\[|\\]|->" },
    { "type": "default", "regex": "." }
  ]
}