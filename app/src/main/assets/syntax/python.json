{
  "name": ["Python", ".py", ".pyw", ".pyx", ".pyi"],
  "comment": { "startsWith": "#" },
  "rules": [
    { "type": "comment", "regex": "#.*$" },
    { "type": "string", "regex": "\"\"\"[\\s\\S]*?\"\"\"" },
    { "type": "string", "regex": "'''[\\s\\S]*?'''" },
    { "type": "string", "regex": "[bBuU]?[rR]?\"(?:\\\\.|[^\"])*\"" },
    { "type": "string", "regex": "[bBuU]?[rR]?'(?:\\\\.|[^'])*'" },
    { "type": "string", "regex": "[fF]\"(?:\\\\.|\\$\\{.*?\\}|[^\"])*\"" },
    { "type": "string", "regex": "[fF]'(?:\\\\.|\\$\\{.*?\\}|[^'])*'" },
    { "type": "number", "regex": "\\b(?:0[xXoObB][0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[jJ]?)\\b" },
    { "type": "keyword", "keywords": ["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"] },
    { "type": "constant", "regex": "\\b[A-Z][A-Z0-9_]+\\b" },
    { "type": "meta", "regex": "@\\w+(?:\\.\\w+)*" },
    { "type": "operator", "regex": "[+\\-*/%=&|!<>^~@]+|:=|\\.\\.\\.|->|:=|\\*\\*|//|<<|>>|<=|>=|==|!=" },
    { "type": "default", "regex": "." }
  ]
}