{
  "name": ["Markdown", ".md", ".markdown", ".mdown"],
  "comment": {},
  "rules": [
    { "type": "meta", "regex": "^#{1,6}\\s+.*$" },
    { "type": "keyword", "regex": "^\\s*[-*+]{1,3}\\s+" },
    { "type": "keyword", "regex": "^\\s*\\d+\\.\\s+" },
    { "type": "string", "regex": "\\[([^\\]]+)\\]\\(([^)]+)\\)" },
    { "type": "string", "regex": "\\!\\[([^\\]]*)\\]\\(([^)]+)\\)" },
    { "type": "tagName", "regex": "\\*\\*(\\S(?:.*?\\S)?)\\*\\*" },
    { "type": "tagName", "regex": "__(\\S(?:.*?\\S)?)__" },
    { "type": "attrName", "regex": "\\*(\\S(?:.*?\\S)?)\\*" },
    { "type": "attrName", "regex": "_(\\S(?:.*?\\S)?)_" },
    { "type": "comment", "regex": "<!--[\\s\\S]*?-->" },
    { "type": "keyword", "regex": "```[\\s\\S]*?```" },
    { "type": "keyword", "regex": "`[^`]+`" },
    { "type": "keyword", "regex": "~~(\\S(?:.*?\\S)?)~~" },
    { "type": "operator", "regex": "^[-=]{3,}$" },
    { "type": "operator", "regex": "^\\|.*\\|$" },
    { "type": "operator", "regex": "^>\\s+" },
    { "type": "default", "regex": "." }
  ]
}