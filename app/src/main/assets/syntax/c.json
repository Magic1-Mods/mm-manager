{
  "name": ["C", ".c", ".h", ".i"],
  "comment": [
    { "startsWith": "//" },
    { "startsWith": "/*", "endsWith": "*/" }
  ],
  "rules": [
    { "type": "comment", "regex": "//.*" },
    { "type": "comment", "regex": "/\\*[\\s\\S]*?\\*/" },
    { "type": "string", "regex": "\"(?:\\\\.|[^\"])*\"" },
    { "type": "string", "regex": "'(?:\\\\.|[^'])'" },
    { "type": "number", "regex": "\\b(?:0[xX][0-9a-fA-F]+[uUlLlL]?[uUlL]?|0[0-7]+[uUlL]?[uUlL]?|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[fFlL]?[uUlL]?)\\b" },
    { "type": "meta", "regex": "#\\s*(?:include|define|ifdef|ifndef|if|else|elif|endif|pragma|error|warning|undef|line|import)\\b" },
    { "type": "meta", "regex": "#\\s*include\\s*[<\"][^>\"]+[>\"]" },
    { "type": "keyword", "keywords": ["auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern", "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return", "short", "signed", "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while", "_Bool", "_Complex", "_Imaginary", "_Alignas", "_Alignof", "_Atomic", "_Generic", "_Noreturn", "_Static_assert", "_Thread_local"] },
    { "type": "constant", "regex": "\\b[A-Z][A-Z0-9_]+\\b" },
    { "type": "operator", "regex": "[+\\-*/%=&|!<>^~?:]+|\\+\\+|--|==|!=|<=|>=|&&|\\|\\||<<|>>|->|\\.|,|;|\\(|\\)|\\{|\\}|\\[|\\]" },
    { "type": "default", "regex": "." }
  ]
}