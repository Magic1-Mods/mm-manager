<?xml version="1.0" encoding="utf-8"?>
<!--
    drawer_file_item.xml
    Used by OpenFileAdapter. All colours are set programmatically via ThemeManager —
    only structure/sizing is defined here.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:minHeight="56dp">

    <!-- Edit / file icon -->
    <ImageView
        android:id="@+id/icon_drawer_file"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_edit"
        android:scaleType="fitCenter"
        android:layout_marginEnd="12dp" />

    <!-- Filename + path stacked vertically -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_drawer_filename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="normal"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="filename.java" />

        <TextView
            android:id="@+id/text_drawer_filepath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="start"
            android:layout_marginTop="1dp"
            android:text="/path/to/file" />

    </LinearLayout>

</LinearLayout>
