<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/editor_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1E1E1E">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_pin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_push_pin"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_undo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_undo"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_redo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_redo"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_save"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_save"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_edit_mode"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_overflow"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />
        </LinearLayout>

        <!-- Tab Strip (filename + cursor position + encoding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#252525"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/textview_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="untitled"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textview_lineno_encoding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:1   UTF-8"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Bar (hidden by default) -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1A1A1A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search..."
                android:textColorHint="#666666"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="text"
                android:paddingHorizontal="8dp"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                android:paddingHorizontal="4dp" />

            <ImageView
                android:id="@+id/btn_search_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#888888" />

            <ImageView
                android:id="@+id/btn_search_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#888888" />

            <ImageView
                android:id="@+id/btn_search_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#888888" />
        </LinearLayout>

        <!-- Code Editor (sora-editor) -->
        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:lnPanelPosition="left"
            app:lnPanelPositionMode="follow" />

        <!-- Symbol Bar -->
        <LinearLayout
            android:id="@+id/symbol_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1A1A1A"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <io.github.rosemoe.sora.widget.SymbolInputView
                android:id="@+id/symbol_input"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Left Drawer (Open Files Panel) -->
    <LinearLayout
        android:id="@+id/editor_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#212121"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Text Editor"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_drawer_edit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />

            <ImageView
                android:id="@+id/btn_drawer_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#CCCCCC" />
        </LinearLayout>

        <!-- File List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_open_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp" />

        <!-- Minimize Button -->
        <Button
            android:id="@+id/btn_minimize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:text="MINIMIZE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#42A5F5"
            android:textAllCaps="true" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
