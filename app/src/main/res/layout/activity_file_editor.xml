<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══════════════════════════════════════ MAIN CONTENT ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editor_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- ── Toolbar ── -->
        <LinearLayout
            android:id="@+id/editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
   																			 android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <!-- Menu / hamburger -->
            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Pin / Search toggle -->
            <ImageView
                android:id="@+id/btn_pin"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_push_pin"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Undo -->
            <ImageView
                android:id="@+id/btn_undo"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_undo"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Redo -->
            <ImageView
                android:id="@+id/btn_redo"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_redo"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Save -->
            <ImageView
                android:id="@+id/btn_save"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_save"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Edit-mode actions -->
            <ImageView
                android:id="@+id/btn_edit_mode"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Overflow -->
            <ImageView
                android:id="@+id/btn_overflow"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- ── Info bar: filename  •  cursor pos + encoding ── -->
        <LinearLayout
            android:id="@+id/editor_info_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/textview_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="untitled"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/textview_lineno_encoding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:1   UTF-8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── 1 dp divider under info bar ── -->
        <View
            android:id="@+id/editor_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <!-- ── Search Bar (hidden by default) ── -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search…"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <ImageView
                android:id="@+id/btn_search_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btn_search_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btn_search_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- ── Code Editor (MH-TextEditor custom Canvas-based) ── -->
        <modder.hub.editor.EditView
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- ── Symbol Panel (draggable bottom sheet) ── -->
        <bin.mg.main.file.SymbolPanel
            android:id="@+id/symbol_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════ LEFT DRAWER ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editor_drawer"
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:elevation="8dp">

        <!-- Drawer header (title + icons) -->
        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Text Editor"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_drawer_edit"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btn_drawer_overflow"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- File list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_open_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp" />

        <!-- Minimize button -->
        <Button
            android:id="@+id/btn_minimize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:text="MINIMIZE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#42A5F5"
            android:textAllCaps="true"
            android:elevation="2dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
