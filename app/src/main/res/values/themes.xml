<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/grey_900</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Default theme attributes -->
        <item name="drawerBackground">@color/white</item>
        <item name="headerBackground">@color/grey_900</item>
        <item name="iconTint">@color/white</item>
        <item name="iconTintSecondary">@color/grey_600</item>
        <item name="textPrimary">@color/grey_900</item>
        <item name="textSecondary">@color/grey_600</item>
        <item name="sectionText">@color/blue_500</item>
        <item name="dividerColor">@color/grey_300</item>
        <item name="progressTint">@color/blue_500</item>
        <item name="mainBackground">#f5f5f5</item>
        <item name="toolbarBackground">@color/grey_900</item>
        <item name="panelBg">@color/white</item>
        <item name="bottomBarBackground">@color/white</item>
        <item name="statsTextColor">@color/grey_500</item>
        <item name="fileItemBackground">@color/white</item>
        <item name="folderItemBackground">#f5f5f5</item>
        <item name="buttonTint">@color/grey_800</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

